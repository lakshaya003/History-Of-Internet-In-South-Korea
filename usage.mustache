<!-- Mustache Template -->
<script id="usage-template" type="text/x-mustache-template">
  <!-- Jumbotron -->
  <header class="jumbotron text-center mb-5">
    <div class="container">
      <h1 class="display-4">{{pageTitle}}</h1>
      <p class="lead">{{tagline}}</p>
    </div>
  </header>

  <!-- Main Content -->
  <div class="container mb-5">
    <div class="row">
      <div class="col-md-8">
        <h2 class="mb-3">Overview</h2>
        <p class="lead">{{overview}}</p>
      </div>
      <div class="col-md-4">
        <div class="card mb-3">
          <img src="{{image.src}}" class="card-img-top" alt="{{image.title}}">
          <div class="card-body">
            <h5 class="card-title">{{image.title}}</h5>
            <p class="card-text">{{image.description}}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Internet Usage Section -->
  <section class="container mb-5">
    <h2 class="mb-4">Internet Usage: Then vs Today</h2>

    <div class="mb-4">
      <h4>Early 2000s – 2010</h4>
      {{#activitiesEarly}}
      <p>{{@index + 1}}. <strong>{{name}}:</strong> {{description}}</p>
      {{/activitiesEarly}}
    </div>

    <div class="mb-4">
      <h4>Today</h4>
      {{#activitiesToday}}
      <p>{{@index + 1}}. <strong>{{name}}:</strong> {{description}}</p>
      {{/activitiesToday}}
    </div>
  </section>

  <!-- Social Media Engagement Section -->
  <section class="container mb-5">
    <h2 class="mb-4">Social Media Engagement: Then vs Today</h2>

    <div class="row">
      <div class="col-md-8">
        <div class="mb-4">
          <h4>Early 2000s – 2010</h4>
          {{#socialMediaEarly}}
          <p>{{@index + 1}}. <strong>{{platform}}:</strong> {{stats}}</p>
          {{/socialMediaEarly}}
        </div>

        <div class="mb-4">
          <h4>Today</h4>
          {{#socialMediaToday}}
          <p>{{@index + 1}}. <strong>{{platform}}:</strong> {{stats}}</p>
          {{/socialMediaToday}}
        </div>
      </div>
      <div class="col-md-4">
        <div class="card mb-3">
          <img src="{{socialMediaImage.src}}" class="card-img-top" alt="{{socialMediaImage.title}}">
          <div class="card-body">
            <h5 class="card-title">{{socialMediaImage.title}}</h5>
            <p class="card-text">{{socialMediaImage.description}}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CyberSecurity Section -->
  <section class="container mb-5">
    <h2 class="mb-4">CyberSecurity: Then vs Today</h2>

    <div class="row">
      <div class="col-md-8">
        <div class="mb-4">
          <h4>Early 2000s</h4>
          {{#cyberSecurity.early2000s}}
          <p>{{@index + 1}}. {{.}}</p>
          {{/cyberSecurity.early2000s}}
        </div>

        <div class="mb-4">
          <h4>Today</h4>
          {{#cyberSecurity.today}}
          <p>{{@index + 1}}. {{.}}</p>
          {{/cyberSecurity.today}}
        </div>
      </div>
      <div class="col-md-4">
        <div class="card mb-3">
          <img src="{{cyberSecurity.image.src}}" class="card-img-top" alt="{{cyberSecurity.image.title}}">
          <div class="card-body">
            <h5 class="card-title">{{cyberSecurity.image.title}}</h5>
            <p class="card-text">{{cyberSecurity.image.description}}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</script>
